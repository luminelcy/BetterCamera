<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>BetterCamera</RootNamespace>
		<LangVersion>default</LangVersion>
		<IsPackable>false</IsPackable>
		<!-- 这里只能写纯数字，所以 1.2.b2 用 1.2.2.0 表示（b2 → .2）。
		     玩家看到的版本号是 Core.cs 里 MelonInfo 那个。 -->
		<AssemblyVersion>1.2.2.0</AssemblyVersion>
		<FileVersion>1.2.2.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>BetterCamera</AssemblyName>
		<LangVersion>latest</LangVersion>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Core.cs" />

		<!-- 基础设施：和 il2cpp 打交道，不含业务 -->
		<Compile Include="Il2Cpp\Il2CppReflection.cs" />
		<Compile Include="Il2Cpp\UnityEventBridge.cs" />
		<Compile Include="Il2Cpp\SliderKit.cs" />
		<Compile Include="Il2Cpp\CallbackGuard.cs" />
		<Compile Include="Il2Cpp\LensKit.cs" />
		<Compile Include="NativeFovChannel.cs" />

		<!-- 游戏访问层：路径常量与组件获取 -->
		<Compile Include="Game\GamePaths.cs" />
		<Compile Include="Game\NativeRefs.cs" />
		<!-- 读"后处理参数实际生效的值"：URP 按优先级混合所有 Volume，只看自己那层会读错（见文件注释） -->
		<Compile Include="Game\PostProcessStack.cs" />
		<Compile Include="Game\GameLanguage.cs" />
		<Compile Include="Game\TmpKit.cs" />

		<!-- 功能层 -->
		<Compile Include="Features\ZoomSlider.cs" />
		<Compile Include="Features\NearClipAdjuster.cs" />
		<Compile Include="Features\FxSlider.cs" />
		<Compile Include="Features\DutchSlider.cs" />
		<Compile Include="Features\DutchReset.cs" />
		<Compile Include="Features\ExitAdjuster.cs" />
		<Compile Include="Features\FocusSlider.cs" />
		<Compile Include="Features\ColorAdjustSliders.cs" />
		<Compile Include="Features\ColorAdjustLabels.cs" />
		<Compile Include="Features\CaptureSizePresets.cs" />

		<Compile Include="SliderHandle.cs" />
		<Compile Include="FX\FXUIHandle.cs" />
		<Compile Include="FovClampHook.cs" />
		<Compile Include="FilterMenuVisibilityHook.cs" />
		<Compile Include="CaptureSizeRatioHook.cs" />
		<!-- 把自定义比例注册成游戏自己的拍照尺寸（插开关字典 + 三处写死分支各补一刀） -->
		<Compile Include="CaptureSizeNativeBridge.cs" />
		<!-- 挡掉克隆体上那个没被 Zenject 注入过的 MonoKernel 在 Start 里抛的空引用 -->
		<Compile Include="MonoKernelGuardHook.cs" />
		<!-- 挡掉克隆体按钮被点击时那条「点击 → 音效」链抛的空引用 -->
		<Compile Include="ClickSoundGuardHook.cs" />
		<!-- 【临时诊断】定位 MelonLoader 日志里那 6 条 Zenject.MonoKernel.Start 空引用是哪个安装器 -->
		<Compile Include="ZenjectInstallTraceHook.cs" />
		<!-- 【临时诊断】定位 DOTween 那几条「目标丢了」的补间在动哪个对象 -->
		<Compile Include="DotweenTargetTraceHook.cs" />
		<!-- 【临时诊断】打印所有 Volume 的后处理参数值与 override 状态 -->
		<Compile Include="ColorStackProbe.cs" />
		<!-- 【临时诊断】用文件当开关，二分定位卡死 -->
		<Compile Include="ProbeFlags.cs" />
		<!-- 把"请求被静默丢弃"变成一行日志（卡死现场唯一的可观察量） -->
		<Compile Include="RequestDropProbeHook.cs" />
		<!-- 把被 Forget() 吞掉的异步异常捞出来 -->
		<Compile Include="UniTaskExceptionProbeHook.cs" />
		<!-- 场景流程的启动点 + installer 所在对象（定位"谁销毁了它"） -->
		<Compile Include="SceneLifecycleProbeHook.cs" />
		<!-- 记录每一次 Object.Destroy 的对象名（销毁 = 取消 destroyCancellationToken） -->
		<Compile Include="DestroyTraceProbeHook.cs" />
		<!-- 抓"谁取消了 destroyCancellationToken"（MonoBehaviour.RaiseCancellation） -->
		<Compile Include="CancellationTraceProbeHook.cs" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="Il2CppInterop.Common">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\net6\Il2CppInterop.Common.dll</HintPath>
	  </Reference>
	  <Reference Include="Il2CppInterop.Generator">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\net6\Il2CppInterop.Generator.dll</HintPath>
	  </Reference>
	  <Reference Include="Il2CppInterop.HarmonySupport">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\net6\Il2CppInterop.HarmonySupport.dll</HintPath>
	  </Reference>
	  <Reference Include="Il2Cppmscorlib">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
	  </Reference>
	  <Reference Include="MelonLoader">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\net6\MelonLoader.dll</HintPath>
	  </Reference>
	  <Reference Include="0Harmony">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\net6\0Harmony.dll</HintPath>
	  </Reference>
	  <Reference Include="Il2CppInterop.Runtime">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Dependencies\Il2CppAssemblyGenerator\UnityDependencies\UnityEngine.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.CoreModule">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Dependencies\Il2CppAssemblyGenerator\UnityDependencies\UnityEngine.CoreModule.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.UI">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Dependencies\Il2CppAssemblyGenerator\Cpp2IL\cpp2il_out\UnityEngine.UI.dll</HintPath>
	  </Reference>
	  <Reference Include="UnityEngine.UIModule">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Dependencies\Il2CppAssemblyGenerator\UnityDependencies\UnityEngine.UIModule.dll</HintPath>
	  </Reference>

	  <!-- 游戏程序集：用于接入原生 RoomCameraFOV 响应式变量 -->
	  <Reference Include="Il2CppBehaviourAssemblyDefinition">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Il2CppBehaviourAssemblyDefinition.dll</HintPath>
	  </Reference>
	  <Reference Include="Il2CppStateVariable">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Il2CppStateVariable.dll</HintPath>
	  </Reference>
	  <Reference Include="Il2CppR3">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Il2CppR3.dll</HintPath>
	  </Reference>
	  <Reference Include="Il2CppDomainAssemblyDefinition">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Il2CppDomainAssemblyDefinition.dll</HintPath>
	  </Reference>
	  <Reference Include="Il2CppCinemachine">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Il2CppCinemachine.dll</HintPath>
	  </Reference>
	  <Reference Include="Il2CppViewAssemblyDefinition">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Il2CppViewAssemblyDefinition.dll</HintPath>
	  </Reference>
	  <!-- 拍照尺寸开关字典的类型（SerializableDictionaryBase<CaptureSize, …>）在这里。
	       引用它是为了让编译器保证"键是 CaptureSize 枚举"—— 见 CaptureSizeNativeBridge 的键类型陷阱说明。 -->
	  <Reference Include="Il2CppRotaryHeart.SerializableDictionaryLite">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Il2CppRotaryHeart.SerializableDictionaryLite.dll</HintPath>
	  </Reference>
	  <Reference Include="Unity.InputSystem">
	    <HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Unity.InputSystem.dll</HintPath>
	  </Reference>
	</ItemGroup>
</Project>